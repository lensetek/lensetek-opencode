packages/core/migration/**/snapshot.json linguist-generated
packages/core/src/database/migration.gen.ts linguist-generated

# Fork-owned branding files: during `sync:upstream` merges these always keep
# the Lensetek version on conflict instead of upstream opencode's values.
# The `ours` merge driver is registered by scripts/sync-upstream.ts.
packages/core/src/branding.ts merge=ours
packages/tui/src/logo.ts merge=ours
packages/tui/src/component/logo.tsx merge=ours

# Keep these as real files (not symlinks): windows checkout fails on symlink
# blobs whose content is mistaken for a link target.
packages/app/src/custom-elements.d.ts merge=ours
packages/enterprise/src/custom-elements.d.ts merge=ours

# Fork's README carries Lensetek branding and install channels.
README.md merge=ours

# Shell scripts must stay LF so curl|bash installers work on any platform.
*.sh text eol=lf
